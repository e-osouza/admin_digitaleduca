# URL base da API DigitalEduca (sem barra no final).
# O projeto trabalha SEMPRE contra a API de staging, que fala com o banco
# clone (digital_educa_dev). O backend de produção está fora de escopo.
NEXT_PUBLIC_API_URL=https://api-dev.digitaleduca.com.vc

# Segredo compartilhado das rotas /dashboard/* do backend.
# NÃO é o JWT: o backend compara este valor fixo num guard próprio
# (DashboardTokenGuard), aceito no header `x-dashboard-token`.
# Sem prefixo NEXT_PUBLIC_ de propósito — nunca pode chegar ao browser.
# Valor: DASHBOARD_TOKEN no .env do backend de staging na VPS.
DASHBOARD_TOKEN=
